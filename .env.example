BIND_ADDR=0.0.0.0:8080
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=cambia_esto
COUCHDB_DB=reparto
RUST_LOG=info,metrica=info

# Replicación opcional con otra base CouchDB. La URL debe terminar en el nombre de la base.
# No usar la base local de Flutter salvo que implemente el protocolo CouchDB/PouchDB.
COUCHDB_REPLICATION_PEER_URL=
COUCHDB_REPLICATION_PEER_USER=
COUCHDB_REPLICATION_PEER_PASSWORD=

# P2 - motor de rutas
FACTOR_CIRCUITO=1.3
# Dejar vacío para usar solo Haversine. Ejemplo con OSRM propio: http://127.0.0.1:5000
OSRM_URL=
OSRM_TIMEOUT_MS=2000